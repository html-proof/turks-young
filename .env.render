# ─────────────────────────────────────────────────────────────────────────────
#  Render deployment environment variables
#  Copy these into Render → Service → Environment tab.
#  Set UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN directly in Render
#  (do not commit the real token to git).
# ─────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO

# Comma-separated allowed CORS origins (* = open to all).
CORS_ALLOW_ORIGINS=*

# ── Supabase PostgreSQL ────────────────────────────────────────────────────────
# Pooler URI (Port 6543 for transaction pooling with statement_cache_size=0)
DATABASE_URL=postgresql://postgres.newhrmnzwpgrzjboafrb:8PNpBZsP2Xe7t6JR@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres


# ── Firebase ──────────────────────────────────────────────────────────────────

FIREBASE_PROJECT_ID=music-hub-d7489
FIREBASE_DATABASE_URL=https://music-hub-d7489-default-rtdb.firebaseio.com
FIREBASE_APP_NAME=music-hub-backend

# Upload service_account.json as a Render Secret File.
# It will be mounted at /etc/secrets/service_account.json automatically.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/service_account.json


# ── Upstash Redis ─────────────────────────────────────────────────────────────

# REST URL from your Upstash dashboard (the https:// one, not rediss://).
UPSTASH_REDIS_REST_URL=https://humorous-horse-160323.upstash.io

# Set this in Render's Environment tab — do NOT commit the real token.
UPSTASH_REDIS_REST_TOKEN=<paste-your-token-in-render-ui>


# ── Upstream HTTP tuning ──────────────────────────────────────────────────────

UPSTREAM_TIMEOUT=5
UPSTREAM_MAX_RETRIES=2


# ── Circuit breaker ───────────────────────────────────────────────────────────

CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=30
CB_WINDOW=60


# ── Cache TTLs (seconds) ──────────────────────────────────────────────────────

# ── Language catalogue ────────────────────────────────────────────────────────
# JSON array of languages shown on the onboarding screen.
# Each entry: {"id":"<slug>","name":"<English>","native_name":"<script>"}
# id must match pattern ^[a-z0-9-]+$
MUSIC_LANGUAGES_JSON=[{"id":"hindi","name":"Hindi","native_name":"हिन्दी"},{"id":"punjabi","name":"Punjabi","native_name":"ਪੰਜਾਬੀ"},{"id":"tamil","name":"Tamil","native_name":"தமிழ்"},{"id":"telugu","name":"Telugu","native_name":"తెలుగు"},{"id":"kannada","name":"Kannada","native_name":"ಕನ್ನಡ"},{"id":"malayalam","name":"Malayalam","native_name":"മലയാളം"},{"id":"bengali","name":"Bengali","native_name":"বাংলা"},{"id":"marathi","name":"Marathi","native_name":"मराठी"},{"id":"gujarati","name":"Gujarati","native_name":"ગુજરાતી"},{"id":"odia","name":"Odia","native_name":"ଓଡ଼ିଆ"},{"id":"english","name":"English","native_name":"English"}]


TTL_SONG=21600
TTL_ALBUM=21600
TTL_ARTIST=21600
TTL_PLAYLIST=3600
TTL_SEARCH=900
TTL_CHARTS=600
TTL_TRENDING=600
TTL_NEW_RELEASES=900
TTL_SIMILAR=3600
