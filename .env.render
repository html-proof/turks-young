# ─────────────────────────────────────────────────────────────────────────────
#  Render deployment environment variables
#  Copy these into Render → Service → Environment tab.
#  Set UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN directly in Render
#  (do not commit the real token to git).
# ─────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO

# Comma-separated allowed CORS origins (* = open to all).
CORS_ALLOW_ORIGINS=*


# ── Firebase ──────────────────────────────────────────────────────────────────

FIREBASE_PROJECT_ID=personal-songs
FIREBASE_DATABASE_URL=https://personal-songs-default-rtdb.firebaseio.com
FIREBASE_APP_NAME=songlist-backend

# Upload service_account.json as a Render Secret File.
# It will be mounted at /etc/secrets/service_account.json automatically.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/service_account.json


# ── Upstash Redis ─────────────────────────────────────────────────────────────

# REST URL from your Upstash dashboard (the https:// one, not rediss://).
UPSTASH_REDIS_REST_URL=https://humorous-horse-160323.upstash.io

# Set this in Render's Environment tab — do NOT commit the real token.
UPSTASH_REDIS_REST_TOKEN=<paste-your-token-in-render-ui>


# ── Upstream HTTP tuning ──────────────────────────────────────────────────────

UPSTREAM_TIMEOUT=5
UPSTREAM_MAX_RETRIES=2


# ── Circuit breaker ───────────────────────────────────────────────────────────

CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=30
CB_WINDOW=60


# ── Cache TTLs (seconds) ──────────────────────────────────────────────────────

TTL_SONG=21600
TTL_ALBUM=21600
TTL_ARTIST=21600
TTL_PLAYLIST=3600
TTL_SEARCH=900
TTL_CHARTS=600
TTL_TRENDING=600
TTL_NEW_RELEASES=900
TTL_SIMILAR=3600
