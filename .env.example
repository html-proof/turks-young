APP_ENV=development
APP_DEBUG=false
API_PREFIX=/api/v1

# Supabase PostgreSQL connection string. Prefer the Supabase transaction pooler
# for deployments that may open many short-lived server connections.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres
DATABASE_MIN_POOL_SIZE=1
DATABASE_MAX_POOL_SIZE=10
DATABASE_SSL=true
# Keep verification enabled when the Supabase CA certificate is installed.
# Set false only to use encrypted sslmode=require without certificate verification.
DATABASE_SSL_VERIFY=true

# Upstash Redis works with a rediss:// connection string.
REDIS_URL=rediss://default:PASSWORD@HOST:6379
# Alternatively, use Upstash's HTTP/REST client with both values below.
# Copy the raw HTTPS endpoint, not the Markdown link shown by some dashboards.
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-the-standard-rest-token
CACHE_NAMESPACE=music-hub

# Lyrics. LRCLIB is the primary source: free, no API key, and the only one of
# the three that returns timestamped lyrics. Leave it enabled unless you are
# deliberately running lyrics-free.
LRCLIB_ENABLED=true
LRCLIB_BASE_URL=https://lrclib.net/api
# LRCLIB asks clients to identify themselves. Put a reachable contact here.
LYRICS_USER_AGENT=MusicHub/1.0 (https://github.com/music-hub)

# Optional licensed lyrics gateway, tried after LRCLIB. Both values are
# required together. The gateway receives GET /lyrics metadata queries and
# returns JSON candidates.
# LYRICS_API_BASE_URL=https://licensed-lyrics.example.com/v1
# LYRICS_API_TOKEN=replace-with-provider-token

# Plain-text last resort. It returns no album, duration or timestamps, so a
# result cannot be verified against the requested recording and is only ever
# shown unsynchronised. Off by default.
LYRICS_OVH_ENABLED=false
LYRICS_OVH_BASE_URL=https://api.lyrics.ovh/v1

LYRICS_REQUEST_TIMEOUT_SECONDS=8
LYRICS_MATCH_CONFIDENCE=0.82
LYRICS_CACHE_TTL=604800
LYRICS_NEGATIVE_CACHE_TTL=3600

# Verifying Firebase ID tokens needs only the project ID -- tokens are checked
# against Google's public signing certificates.
FIREBASE_PROJECT_ID=personal-songs

# A service account is required only for token revocation checks and account
# deletion. Provide one of the two below, or Application Default Credentials.
# FIREBASE_CREDENTIALS_JSON is the whole service-account JSON on a single line
# and is the right choice on Render/Fly/Heroku, where no file can be mounted.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"personal-songs","private_key":"...","client_email":"..."}
# FIREBASE_CREDENTIALS_PATH=C:\secure\firebase-service-account.json

# Requires a service account. Ignored (with a startup warning) without one.
FIREBASE_CHECK_REVOKED=true

# Comma-separated frontend origins. Do not use * in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Replace this in every deployed environment.
CURSOR_SECRET=replace-with-a-long-random-secret
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Same value as the CDN worker's PROXY_SHARED_SECRET wrangler secret. With it
# set, requests arriving through the worker are rate limited per real client
# (CF-Connecting-IP); without it, per address seen by the platform proxy.
# PROXY_SHARED_SECRET=replace-with-a-long-random-secret
